# ──────────────────────────────────────────────
# Sanity CMS
# ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here    # Sanity project ID (from sanity.io/manage)
NEXT_PUBLIC_SANITY_DATASET=production                 # Dataset name (production / staging)
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-17             # API version date string
SANITY_API_TOKEN=your_token_here                      # Server-side token for write/preview operations

# ──────────────────────────────────────────────
# Shopify Storefront
# ──────────────────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com    # Shopify store domain
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=your_token_here      # Private storefront access token (server-side only)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_token_here  # Public storefront access token (client-side cart)
SHOPIFY_API_VERSION=2025-01                                  # Shopify API version (shared across all Shopify APIs)

# ──────────────────────────────────────────────
# Shopify Admin API
# ──────────────────────────────────────────────
SHOPIFY_ADMIN_CLIENT_ID=your_client_id_here           # Admin API app client ID
SHOPIFY_ADMIN_CLIENT_SECRET=your_client_secret_here   # Admin API app client secret

# ──────────────────────────────────────────────
# Shopify Customer Account API
# ──────────────────────────────────────────────
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_client_id_here       # Customer Account API client ID
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=your_account_api_url_here   # Customer Account API URL (e.g. https://shopify.com/xxxxx)
SHOPIFY_SHOP_ID=your_shop_id_here                            # Numeric shop ID for customer API queries
APP_URL=http://localhost:3000                                 # App origin URL (used for OAuth redirects)
SESSION_SECRET=your_session_secret_here                       # Secret for signing session cookies

# ──────────────────────────────────────────────
# Clerk (admin dashboard auth)
# ──────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_key_here       # Clerk publishable key (client-side)
CLERK_SECRET_KEY=your_key_here                        # Clerk secret key (server-side)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in                # Sign-in page path
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/                 # Redirect after sign-in

# ──────────────────────────────────────────────
# Resend (transactional email)
# ──────────────────────────────────────────────
RESEND_API_KEY=your_key_here                          # Resend API key for sending emails

# ──────────────────────────────────────────────
# Helcim (in-person POS)
# ──────────────────────────────────────────────
HELCIM_API_TOKEN=your_token_here                      # Helcim API token for inventory sync
HELCIM_WEBHOOK_VERIFIER_TOKEN=your_token_here         # Webhook signature verification token
SHOPIFY_LOCATION_ID=gid://shopify/Location/xxxxx      # Shopify location GID for inventory adjustments

# ──────────────────────────────────────────────
# Cloudflare Turnstile (spam protection)
# ──────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_key_here          # Turnstile site key (client-side widget)
TURNSTILE_SECRET_KEY=your_key_here                    # Turnstile secret key (server-side verification)

# ──────────────────────────────────────────────
# Upstash Redis (rate limiting)
# ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=your_url_here                  # Upstash Redis REST endpoint
UPSTASH_REDIS_REST_TOKEN=your_token_here              # Upstash Redis REST auth token

# ──────────────────────────────────────────────
# Google Maps
# ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here         # Google Maps API key (Places autocomplete)

# ──────────────────────────────────────────────
# Cloudinary (image hosting)
# ──────────────────────────────────────────────
CLOUDINARY_URL=your_cloudinary_url_here               # Cloudinary connection string (server-side SDK)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name     # Cloudinary cloud name (client-side next-cloudinary)

# ──────────────────────────────────────────────
# Cloudflare R2 (digital product delivery)
# ──────────────────────────────────────────────
R2_ENDPOINT=your_endpoint_here                        # R2 S3-compatible endpoint URL
R2_ACCESS_KEY_ID=your_key_here                        # R2 access key
R2_SECRET_ACCESS_KEY=your_secret_here                 # R2 secret key
R2_BUCKET_NAME=your_bucket_here                       # R2 bucket name

# ──────────────────────────────────────────────
# Database (Neon serverless PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=your_pooled_url_here                     # Neon pooled connection URL (runtime queries)
DIRECT_URL=your_direct_url_here                       # Neon direct connection URL (migrations only)

# ──────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────
NEXT_PUBLIC_GRAIN_OVERLAY=true                        # Enable grain texture overlay on images
NEXT_PUBLIC_POLAROID_STYLE=true                       # Enable polaroid-style photo treatments
