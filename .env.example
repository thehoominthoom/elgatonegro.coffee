# Database
DATABASE_URL=                           # Neon pooled URL
DIRECT_URL=                             # Neon direct URL (migrations only)

# Auth
AUTH_SECRET=                            # Auth.js secret (generate: openssl rand -base64 32)
NEXTAUTH_URL=                           # https://elgatonegro.coffee

# Email
RESEND_API_KEY=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Cloudinary
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare R2 (digital product delivery)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Feature flags (both default true — baked in at build time)
NEXT_PUBLIC_GRAIN_OVERLAY=true
NEXT_PUBLIC_POLAROID_STYLE=true
